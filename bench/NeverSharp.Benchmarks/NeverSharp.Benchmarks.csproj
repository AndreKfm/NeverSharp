<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BenchmarkDotNet benchmarks: ranking of Track F attempts (pre-registration §5.2) and Track O variants.
    Compiles the Track F sources of the checkout it lives in directly (not a project reference), so the
    internal ported code is reachable and each attempt's worktree can be measured as it is.
    Usage: dotnet run -c Release, with the BenchmarkDotNet argument filter *M1* after the separator (see Program.cs)
  -->
  <PropertyGroup>
    <NeverSharpTrack Condition="'$(NeverSharpTrack)' == ''">Faithful</NeverSharpTrack>
    <DefineConstants Condition="'$(NeverSharpTrack)' == 'Optimized'">$(DefineConstants);TRACK_OPTIMIZED</DefineConstants>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Ported code is compiled in; its analyzers run in its own project (Gate 2), not here. -->
    <RunAnalyzers>false</RunAnalyzers>
    <!-- CS0649: the compiler skips this check for internal fields in the Faithful project (InternalsVisibleTo), not here. -->
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- -p:NeverSharpTrack=Optimized measures Track O (its variants) with the same workloads. -->
    <Compile Include="$(RepoRoot)src/NeverSharp.$(NeverSharpTrack)/**/*.cs" Exclude="$(RepoRoot)src/NeverSharp.$(NeverSharpTrack)/bin/**;$(RepoRoot)src/NeverSharp.$(NeverSharpTrack)/obj/**" LinkBase="$(NeverSharpTrack)" />
    <Compile Include="$(RepoRoot)src/Generated/*.g.cs" LinkBase="Generated" />
  </ItemGroup>
  <!--
    BenchmarkDotNet depends on Microsoft.Diagnostics.Tracing.TraceEvent, which exports the top-level namespace
    Diagnostics (Diagnostics.Tracing.*). Compiled together with the ported sources, that namespace hides the
    generated class NeverSharp.Generated.Diagnostics (global namespace members win over using directives).
    An extern alias takes the assembly out of the global namespace; nothing here uses it.
  -->
  <Target Name="AliasTraceEvent" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'Microsoft.Diagnostics.Tracing.TraceEvent'">
        <Aliases>traceevent</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
