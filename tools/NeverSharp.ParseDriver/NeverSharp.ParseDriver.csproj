<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Parse-only driver for the C# tracks (driver contract: docs/benchmark-harness.md §4.1).
    Build one executable per track and runtime configuration:
      dotnet publish -c Release -r win-x64 -p:NeverSharpTrack=Faithful|Optimized -p:NeverSharpRuntime=aot-ws|aot-srv|jit-ws|jit-srv
    (harness/bench/build-cs.mjs publishes all of them).
  -->
  <Import Project="$(RepoRoot)eng/RuntimeConfiguration.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NeverSharpTrack Condition="'$(NeverSharpTrack)' == ''">Faithful</NeverSharpTrack>
    <AssemblyName>parse-cs-$(NeverSharpTrack.ToLowerInvariant())-$(NeverSharpRuntime)</AssemblyName>
    <DefineConstants>$(DefineConstants);TRACK_$(NeverSharpTrack.ToUpperInvariant())</DefineConstants>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/NeverSharp.$(NeverSharpTrack)/NeverSharp.$(NeverSharpTrack).csproj" />
  </ItemGroup>
  <!-- check mode (Track O): TypeScript 6.0.3's default library next to the executable, in lib/ (the pinned package the
       Gate C oracle reads). -->
  <ItemGroup Condition="'$(NeverSharpTrack)' == 'Optimized'">
    <None Include="$(RepoRoot)harness/astdump/node_modules/typescript/lib/lib.*.d.ts" Link="lib/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
