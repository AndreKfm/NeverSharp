<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The canonical dump writers (tools/NeverSharp.Dump, the same sources) compiled against Track O,
    so both tracks are checked by one writer. Default outputs: dumps/cs-optimized, cs-optimized-parsenone,
    cs-optimized-tokens. Phase 2 (module B0): this project's own Program.cs (the shared one plus mode "binder")
    and BinderDump.cs, the binder dump (dumps/cs-optimized-binder-<mode>).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);TRACK_OPTIMIZED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)tools/NeverSharp.Dump/*.cs" Exclude="$(RepoRoot)tools/NeverSharp.Dump/Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/NeverSharp.Optimized/NeverSharp.Optimized.csproj" />
  </ItemGroup>
</Project>
